{
  "name": "@vendurepos/plugin",
  "version": "0.1.0",
  "description": "VendurePOS server plugin for Vendure: TallyUI's order.create command as one Postgres transaction per command (ADR 0002).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vendurepos/app.git",
    "directory": "packages/vendure-plugin"
  },
  "homepage": "https://github.com/vendurepos/app/tree/main/packages/vendure-plugin#readme",
  "bugs": "https://github.com/vendurepos/app/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": "^20.19 || >=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:up": "scripts/test-stack.sh up",
    "db:down": "scripts/test-stack.sh down",
    "test": "vitest run --maxWorkers=1",
    "test:stack": "bash scripts/test-stack.test.sh",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@vendure/core": "^3.6.0",
    "@vendure/email-plugin": "^3.6.0",
    "typeorm": "^0.3.21"
  },
  "peerDependenciesMeta": {
    "@vendure/email-plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@types/node": "24.19.0",
    "@vendure/core": "3.7.3",
    "@vendure/email-plugin": "3.7.3",
    "@vendure/testing": "3.7.3",
    "pg": "8.23.0",
    "typeorm": "0.3.31",
    "typescript": "~5.8.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.0.18"
  }
}
