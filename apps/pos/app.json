{
  "expo": {
    "name": "VendurePOS",
    "slug": "vendurepos",
    "version": "0.1.0",
    "scheme": "vendurepos",
    "userInterfaceStyle": "automatic",
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", ["expo-camera", { "cameraPermission": "VendurePOS uses the camera to scan product barcodes.", "recordAudioAndroid": false }]],
    "experiments": { "typedRoutes": true }
  }
}
