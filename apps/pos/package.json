{
  "name": "@vendurepos/pos",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "expo start",
    "build:web": "tallyui-build-sqlite-worker public/ && expo export --platform web && node scripts/csp-lan-http.ts dist && node scripts/demo-share.ts dist",
    "build:web:demo": "mkdir -p node_modules/.cache/demo-build && TMPDIR=\"$PWD/node_modules/.cache/demo-build\" EXPO_PUBLIC_VENDUREPOS_DEMO=1 pnpm run build:web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tallyui/components": "3.0.4",
    "@tallyui/connector-vendure": "3.0.4",
    "@tallyui/core": "3.0.4",
    "@tallyui/database": "3.0.4",
    "@tallyui/pos": "3.0.4",
    "@tallyui/primitives": "3.0.4",
    "@tallyui/storage-sqlite": "3.0.4",
    "@tallyui/theme": "3.0.4",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "rxdb": "17.5.0",
    "rxdb-premium": "17.5.0",
    "rxjs": "7.8.2",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.8.3"
  }
}
