    "clean": "turbo clean"
  },
  "devDependencies": {
    "happy-dom": "20.14.5",
    "turbo": "^2.5.0",
    "typescript": "~5.8.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "rxdb-premium"]
  }
}
